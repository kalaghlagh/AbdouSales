<Window x:Class="AbdouSales.Views.TemplateChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AbdouSales.Services"
        Title="{DynamicResource S080}" Height="620" Width="980" MinHeight="500" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="Segoe UI" Foreground="{DynamicResource BrushFieldText}"
        Background="{DynamicResource BrushBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S116}" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource BrushHeading}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource S117}"
                   FontSize="14" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,18" TextWrapping="Wrap"/>

        <UniformGrid Grid.Row="2" Rows="1" Columns="3" MinHeight="300">

            <!-- ===== كلاسيكي (أبيض وأسود) ===== -->
            <Border x:Name="ClassicCard" Margin="10" CornerRadius="14" Background="{DynamicResource BrushSurface}"
                    BorderThickness="2" BorderBrush="{DynamicResource BrushBorder}" Cursor="Hand"
                    MouseLeftButtonUp="ClassicCard_Click">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- معاينة مصغّرة -->
                    <Border Grid.Row="0" Background="White" BorderBrush="Black" BorderThickness="1.2" Padding="10">
                        <StackPanel>
                            <Border Background="Black" Padding="4" Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource S118}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            </Border>
                            <Rectangle Height="6" Fill="#EEEEEE" Margin="0,0,0,4"/>
                            <Rectangle Height="6" Fill="#EEEEEE" Margin="0,0,0,4"/>
                            <Rectangle Height="6" Fill="#EEEEEE" Margin="0,0,0,10"/>
                            <Border Background="Black" Padding="3" Margin="0,0,0,3">
                                <TextBlock Text="{DynamicResource S119}" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
                            </Border>
                            <Rectangle Height="5" Fill="#F5F5F5" Margin="0,0,0,3"/>
                            <Rectangle Height="5" Fill="#F5F5F5" Margin="0,0,0,10"/>
                            <Border BorderBrush="Black" BorderThickness="1" Padding="4" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource S120}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{DynamicResource S121}" FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" Margin="0,12,0,2"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource S122}" FontSize="11"
                               Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===== احترافي كحلي ===== -->
            <Border x:Name="NavyCard" Margin="10" CornerRadius="14" Background="{DynamicResource BrushSurface}"
                    BorderThickness="2" BorderBrush="{StaticResource BrushDarkBlue}" Cursor="Hand"
                    MouseLeftButtonUp="NavyCard_Click">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BrushDarkBlue}" BorderThickness="1.2" Padding="10">
                        <StackPanel>
                            <Border Background="{StaticResource BrushDarkBlue}" Padding="4" Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource S118}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            </Border>
                            <Rectangle Height="6" Fill="#EAF0F8" Margin="0,0,0,4"/>
                            <Rectangle Height="6" Fill="#EAF0F8" Margin="0,0,0,4"/>
                            <Rectangle Height="6" Fill="#EAF0F8" Margin="0,0,0,10"/>
                            <Border Background="{StaticResource BrushDarkBlue}" Padding="3" Margin="0,0,0,3">
                                <TextBlock Text="{DynamicResource S119}" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
                            </Border>
                            <Rectangle Height="5" Fill="#F5F8FB" Margin="0,0,0,3"/>
                            <Rectangle Height="5" Fill="#F5F8FB" Margin="0,0,0,10"/>
                            <Border Background="#EAF0F8" Padding="4" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource S120}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushHeading}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{DynamicResource S123}" FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" Margin="0,12,0,2"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource S124}" FontSize="11"
                               Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===== عصري أزرق ملكي ===== -->
            <Border x:Name="RoyalCard" Margin="10" CornerRadius="14" Background="{DynamicResource BrushSurface}"
                    BorderThickness="2" BorderBrush="{StaticResource BrushBlue}" Cursor="Hand"
                    MouseLeftButtonUp="RoyalCard_Click">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BrushBlue}" BorderThickness="1.4"
                            CornerRadius="8" Padding="10">
                        <StackPanel>
                            <Border Background="{StaticResource BrushBlue}" CornerRadius="6" Padding="4" Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource S118}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            </Border>
                            <Rectangle Height="6" Fill="#E4ECFD" RadiusX="3" RadiusY="3" Margin="0,0,0,4"/>
                            <Rectangle Height="6" Fill="#E4ECFD" RadiusX="3" RadiusY="3" Margin="0,0,0,4"/>
                            <Rectangle Height="6" Fill="#E4ECFD" RadiusX="3" RadiusY="3" Margin="0,0,0,10"/>
                            <Border Background="{StaticResource BrushBlue}" CornerRadius="5" Padding="3" Margin="0,0,0,3">
                                <TextBlock Text="{DynamicResource S119}" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
                            </Border>
                            <Rectangle Height="5" Fill="#EEF3FE" RadiusX="3" RadiusY="3" Margin="0,0,0,3"/>
                            <Rectangle Height="5" Fill="#EEF3FE" RadiusX="3" RadiusY="3" Margin="0,0,0,10"/>
                            <Border Background="{StaticResource BrushBlue}" CornerRadius="5" Padding="4" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource S120}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{DynamicResource S125}" FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" Margin="0,12,0,2"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource S126}" FontSize="11"
                               Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Grid>
            </Border>

        </UniformGrid>

        <CheckBox svc:UiVisibility.Key="TemplateChooser.SetAsDefaultCheck" x:Name="SetAsDefaultCheck" Grid.Row="3" Content="{DynamicResource S127}"
                  FontSize="14" FontWeight="SemiBold" Margin="4,16,0,4" IsChecked="True"
                  HorizontalAlignment="Right" FlowDirection="{DynamicResource AppFlowDirection}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Content="{DynamicResource S128}" Style="{StaticResource ActionButton}" Click="Apply_Click" Margin="0,0,8,0"/>
            <Button svc:UiVisibility.Key="TemplateChooser.Cancel_Click" Content="{DynamicResource S095}" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
