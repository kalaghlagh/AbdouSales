<Window x:Class="AbdouSales.Views.InvoiceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AbdouSales.Services"
        Title="{DynamicResource S061}" Height="600" Width="900" MinHeight="440" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="Segoe UI" Foreground="{DynamicResource BrushFieldText}"
        Background="{DynamicResource BrushBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S062}" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource BrushHeading}" Margin="0,0,0,16"/>

        <DataGrid Grid.Row="1" x:Name="InvoicesGrid" AutoGenerateColumns="False" IsReadOnly="False"
                  SelectionMode="Single" CanUserAddRows="False" CellEditEnding="InvoicesGrid_CellEditEnding"
                  Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource S063}" Binding="{Binding Number}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource S064}" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource S065}" Binding="{Binding CustomerName}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource S066}" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="1.4*" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource S048}" Binding="{Binding PaymentMethod}" Width="*" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="{DynamicResource S144}" Binding="{Binding IsPaid}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button svc:UiVisibility.Key="InvoiceList.PrintSelected_Click" Content="{DynamicResource S067}" Style="{StaticResource ActionButton}" Click="PrintSelected_Click" Margin="0,0,8,0"/>
            <Button svc:UiVisibility.Key="InvoiceList.ShareSelected_Click" Content="{DynamicResource S068}" Style="{StaticResource ActionButton}" Background="#34A853" Click="ShareSelected_Click" Margin="0,0,8,0"/>
            <Button svc:UiVisibility.Key="InvoiceList.DeleteSelected_Click" Content="{DynamicResource S069}" Style="{StaticResource DangerButton}" Click="DeleteSelected_Click" Margin="0,0,8,0"/>
            <Button svc:UiVisibility.Key="InvoiceList.Close_Click" Content="{DynamicResource S012}" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
