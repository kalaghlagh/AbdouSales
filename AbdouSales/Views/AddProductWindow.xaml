<Window x:Class="AbdouSales.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AbdouSales.Services"
        Title="{DynamicResource S013}" Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="Segoe UI" Foreground="{DynamicResource BrushFieldText}"
        Background="{DynamicResource BrushBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S014}" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource BrushPurple}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="20" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{DynamicResource S015}" Style="{StaticResource InputLabel}"/>
                    <TextBox svc:FieldHint.Text="{DynamicResource S174}" x:Name="NameBox"/>
                </StackPanel>
                <StackPanel svc:UiVisibility.Key="AddProduct.UnitBox" Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="{DynamicResource S016}" Style="{StaticResource InputLabel}"/>
                    <ComboBox x:Name="UnitBox" IsEditable="True">
                        <ComboBoxItem Content="{DynamicResource S017}"/>
                        <ComboBoxItem Content="{DynamicResource S018}"/>
                        <ComboBoxItem Content="{DynamicResource S019}"/>
                        <ComboBoxItem Content="{DynamicResource S020}"/>
                        <ComboBoxItem Content="{DynamicResource S021}"/>
                        <ComboBoxItem Content="{DynamicResource S022}"/>
                        <ComboBoxItem Content="{DynamicResource S023}"/>
                        <ComboBoxItem Content="{DynamicResource S024}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="{DynamicResource S025}" Style="{StaticResource InputLabel}"/>
                    <TextBox svc:FieldHint.Text="0.00" x:Name="PriceBox"/>
                </StackPanel>

                <StackPanel svc:UiVisibility.Key="AddProduct.BarcodeBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="{DynamicResource S026}" Style="{StaticResource InputLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox svc:FieldHint.Text="{DynamicResource S173}" x:Name="BarcodeBox" Grid.Column="0"/>
                        <Button svc:UiVisibility.Key="AddProduct.GenerateBarcode_Click" Grid.Column="2" Content="{DynamicResource S027}" Style="{StaticResource SecondaryButton}" Click="GenerateBarcode_Click"/>
                    </Grid>
                </StackPanel>
                <StackPanel svc:UiVisibility.Key="AddProduct.CostPriceBox" Grid.Row="2" Grid.Column="4">
                    <TextBlock Text="{DynamicResource S153}" Style="{StaticResource InputLabel}"/>
                    <TextBox svc:FieldHint.Text="0.00" x:Name="CostPriceBox"/>
                </StackPanel>

                <!-- ممونو هذه السلعة (علاقة متعدد-إلى-متعدد SupplierProducts) مع سعر الشراء ورمز السلعة عند كل ممون -->
                <StackPanel svc:UiVisibility.Key="AddProduct.SuppliersLinkGrid" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5">
                    <TextBlock Text="{DynamicResource S158}" Style="{StaticResource InputLabel}"/>
                    <DataGrid x:Name="SuppliersLinkGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              MaxHeight="170" HeadersVisibility="Column" Background="{DynamicResource BrushSurface}"
                              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource S165}" Binding="{Binding Name}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="{DynamicResource S159}" Binding="{Binding PurchasePriceText, UpdateSourceTrigger=LostFocus}" Width="1.4*"
                                                ElementStyle="{StaticResource LtrCellText}"/>
                            <DataGridTextColumn Header="{DynamicResource S160}" Binding="{Binding Code, UpdateSourceTrigger=LostFocus}" Width="1.4*"
                                                ElementStyle="{StaticResource LtrCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel svc:UiVisibility.Key="AddProduct.StockBox" Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,8">
                <TextBlock Text="{DynamicResource S028}" Style="{StaticResource InputLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox svc:FieldHint.Text="0.00" x:Name="StockBox" Width="140"/>
            </StackPanel>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                <Button svc:UiVisibility.Key="AddProduct.Save_Click" Content="{DynamicResource S029}" Style="{StaticResource ActionButton}" Background="{StaticResource BrushPurple}" Click="Save_Click" Margin="0,0,8,8"/>
                <Button svc:UiVisibility.Key="AddProduct.Delete_Click" Content="{DynamicResource S010}" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,8,8"/>
                <Button svc:UiVisibility.Key="AddProduct.AssignSupplier_Click" Content="{DynamicResource S183}" Style="{StaticResource ActionButton}" Background="{StaticResource BrushTeal}" Click="AssignSupplier_Click" Margin="0,0,8,8"/>
                <Button svc:UiVisibility.Key="AddProduct.Clear_Click" Content="{DynamicResource S011}" Style="{StaticResource SecondaryButton}" Click="Clear_Click" Margin="0,0,8,8"/>
                <Button svc:UiVisibility.Key="AddProduct.ImportExcel_Click" Content="{DynamicResource S161}" Style="{StaticResource SecondaryButton}" Click="ImportExcel_Click" Margin="8,0,8,8"/>
                <Button svc:UiVisibility.Key="AddProduct.ExcelTemplate_Click" Content="{DynamicResource S162}" Style="{StaticResource SecondaryButton}" Click="ExcelTemplate_Click" Margin="0,0,8,8"/>
            </WrapPanel>

            <!-- شريط التحديد: تحديد الكل / إلغاء التحديد وعدد السلع المحددة -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                <Button svc:UiVisibility.Key="AddProduct.SelectAll_Click" Content="{DynamicResource S181}" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="13" Click="SelectAll_Click" Margin="0,0,8,0"/>
                <Button svc:UiVisibility.Key="AddProduct.SelectNone_Click" Content="{DynamicResource S182}" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="13" Click="SelectNone_Click" Margin="0,0,14,0"/>
                <TextBlock Text="{DynamicResource S184}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock x:Name="SelectedCountText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource BrushPurple}"/>
            </StackPanel>

            <DataGrid Grid.Row="3" x:Name="ProductsGrid" MinHeight="180" MaxHeight="420" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False" MouseDoubleClick="ProductsGrid_MouseDoubleClick"
                      Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{DynamicResource S175}" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="SelectCheck_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource S030}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="{DynamicResource S016}" Binding="{Binding Unit}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="{DynamicResource S031}" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource S153}" Binding="{Binding CostPrice, StringFormat={}{0:N2}}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource S028}" Binding="{Binding QuantityInStock, StringFormat={}{0:N2}}" Width="150"/>
                    <DataGridTextColumn Header="{DynamicResource S032}" Binding="{Binding Barcode}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button svc:UiVisibility.Key="AddProduct.Close_Click" Grid.Row="4" Content="{DynamicResource S012}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Close_Click"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
