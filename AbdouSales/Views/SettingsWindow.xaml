<Window x:Class="AbdouSales.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AbdouSales.Services"
        Title="{DynamicResource S096}" Height="660" Width="780" MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="Segoe UI" Foreground="{DynamicResource BrushFieldText}"
        Background="{DynamicResource BrushBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S082}" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource BrushHeading}" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- أقسام الإعدادات -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="TabAppearance" GroupName="SettingsTabs" Style="{StaticResource SectionTab}"
                         Content="{DynamicResource S187}" Checked="Tab_Checked" Margin="0,0,8,6"/>
            <RadioButton x:Name="TabVisibility" GroupName="SettingsTabs" Style="{StaticResource SectionTab}"
                         Content="{DynamicResource S188}" Checked="Tab_Checked" Margin="0,0,8,6"/>
            <RadioButton x:Name="TabCompany" GroupName="SettingsTabs" Style="{StaticResource SectionTab}"
                         Content="{DynamicResource S189}" Checked="Tab_Checked" Margin="0,0,8,6"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>

                <!-- ===== المظهر واللغة ===== -->
                <Border x:Name="AppearancePanel" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="20"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S190}" Style="{StaticResource InputLabel}" FontSize="15"/>
                        <TextBlock Text="{DynamicResource S191}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeLightRadio" GroupName="ThemeGroup" Style="{StaticResource SectionTab}"
                                         Content="{DynamicResource S192}" Checked="Theme_Checked" Padding="22,10"/>
                            <RadioButton x:Name="ThemeDarkRadio" GroupName="ThemeGroup" Style="{StaticResource SectionTab}"
                                         Content="{DynamicResource S193}" Checked="Theme_Checked" Padding="22,10"/>
                        </StackPanel>

                        <Separator Margin="0,18,0,14" Background="{DynamicResource BrushBorder}"/>

                        <TextBlock Text="{DynamicResource S148}" Style="{StaticResource InputLabel}" FontSize="15"/>
                        <TextBlock Text="{DynamicResource S154}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ArabicLangButton" Content="العربية" Click="ArabicLang_Click"
                                    Background="{StaticResource BrushDarkBlue}" Foreground="White" BorderThickness="0"
                                    Padding="16,8" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button x:Name="FrenchLangButton" Content="Français" Click="FrenchLang_Click"
                                    Background="#C7CFDA" Foreground="#333" BorderThickness="0"
                                    Padding="16,8" Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== إظهار / إخفاء الأزرار والخيارات في كل نافذة ===== -->
                <Border x:Name="VisibilityPanel" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="20"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S194}" FontSize="12.5" Foreground="{DynamicResource BrushTextMuted}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="{DynamicResource S197}" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="13"
                                HorizontalAlignment="Left" Click="ShowEverything_Click" Margin="0,0,0,14"/>
                        <StackPanel x:Name="VisibilityHost"/>
                    </StackPanel>
                </Border>

                <!-- ===== معلومات الشركة ===== -->
                <Border x:Name="CompanyPanel" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="20"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S097}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushHeading}" Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource S098}" Style="{StaticResource InputLabel}"/>
                        <TextBox svc:FieldHint.Text="{DynamicResource S166}" x:Name="NameBox" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource S004}" Style="{StaticResource InputLabel}"/>
                        <TextBox svc:FieldHint.Text="{DynamicResource S167}" x:Name="ActivityBox" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource S005}" Style="{StaticResource InputLabel}"/>
                        <TextBox svc:FieldHint.Text="{DynamicResource S168}" x:Name="AddressBox" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource S007}" Style="{StaticResource InputLabel}"/>
                                <TextBox svc:FieldHint.Text="{DynamicResource S170}" x:Name="CommercialRegisterBox" svc:BidiText.KeepOrder="True" TextAlignment="Left" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource S008}" Style="{StaticResource InputLabel}"/>
                                <TextBox svc:FieldHint.Text="{DynamicResource S171}" x:Name="TaxIdBox" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource S099}" Style="{StaticResource InputLabel}"/>
                                <TextBox svc:FieldHint.Text="{DynamicResource S172}" x:Name="ArticleNumberBox" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource S006}" Style="{StaticResource InputLabel}"/>
                                <TextBox svc:FieldHint.Text="{DynamicResource S169}" x:Name="PhoneBox" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="{DynamicResource S101}" Style="{StaticResource ActionButton}" Background="{StaticResource BrushRose}"
                                Click="ChooseTemplate_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="{DynamicResource S100}" Style="{StaticResource ActionButton}" Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource S012}" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
