<Window x:Class="AbdouSales.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AbdouSales.Services"
        Title="{DynamicResource S129}" Height="620" Width="1160" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="Segoe UI" Foreground="{DynamicResource BrushFieldText}"
        Background="{DynamicResource BrushBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource S130}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushHeading}" VerticalAlignment="Center"/>
            <Button svc:UiVisibility.Key="Dashboard.Refresh_Click" Content="{DynamicResource S141}" Click="Refresh_Click" Margin="16,0,0,0"
                    Style="{StaticResource SecondaryButton}" Padding="12,6"/>
        </StackPanel>

        <!-- ===== بطاقات الملخص ===== -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,16">

            <Border svc:UiVisibility.Key="Dashboard.CardRevenue" Margin="6" CornerRadius="12" Background="#2F7DE1" Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S131}" Foreground="#DCE7FB" FontSize="13"/>
                    <TextBlock x:Name="RevenueText" Text="0.00" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border svc:UiVisibility.Key="Dashboard.CardProfit" Margin="6" CornerRadius="12" Background="#34A853" Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S132}" Foreground="#DFF5E4" FontSize="13"/>
                    <TextBlock x:Name="ProfitText" Text="0.00" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border svc:UiVisibility.Key="Dashboard.CardUnpaid" Margin="6" CornerRadius="12" Background="#E05555" Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S133}" Foreground="#FBDCDC" FontSize="13"/>
                    <TextBlock x:Name="UnpaidCountText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock x:Name="UnpaidAmountText" Text="0.00" Foreground="#FBDCDC" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border svc:UiVisibility.Key="Dashboard.CardLowStock" Margin="6" CornerRadius="12" Background="#F2994A" Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S135}" Foreground="#FDEBD9" FontSize="13"/>
                    <TextBlock x:Name="LowStockCountText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- ===== الجداول ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- المخزون -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource S136}" FontWeight="Bold" FontSize="15" Margin="4,0,4,8"/>
                    <DataGrid Grid.Row="1" x:Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource S045}" Binding="{Binding Name}" Width="2.2*"/>
                            <DataGridTextColumn Header="{DynamicResource S016}" Binding="{Binding Unit}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource S028}" Binding="{Binding QuantityInStock, StringFormat={}{0:N2}}" Width="1.1*"/>
                            <DataGridTextColumn Header="{DynamicResource S137}" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="1.1*"/>
                            <DataGridTextColumn Header="{DynamicResource S138}" Binding="{Binding StockValue, StringFormat={}{0:N2}}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- الفواتير غير المدفوعة -->
            <Border Grid.Column="2" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource S150}" FontWeight="Bold" FontSize="15" Margin="4,0,4,8"/>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="UnpaidGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource S063}" Binding="{Binding Number}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource S065}" Binding="{Binding CustomerName}" Width="1.4*"/>
                                <DataGridTextColumn Header="{DynamicResource S066}" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="1.1*"/>
                                <DataGridTemplateColumn Header="" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{DynamicResource S140}" FontSize="11" Padding="6,3"
                                                    Background="{StaticResource BrushGreen}" Foreground="White" BorderThickness="0"
                                                    Cursor="Hand" Click="MarkPaid_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="NoUnpaidText" Text="{DynamicResource S139}" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button svc:UiVisibility.Key="Dashboard.Close_Click" Content="{DynamicResource S012}" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
