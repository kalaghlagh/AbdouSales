<Window x:Class="AbdouSales.Views.InvoicePrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AbdouSales.Services"
        Title="{DynamicResource S070}" Height="620" Width="980"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="Segoe UI"
        Background="#4F5968">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18" Background="#DDE1E7" CornerRadius="4" Padding="10">
            <FlowDocumentScrollViewer x:Name="Viewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="#DDE1E7"/>
        </Border>

        <Border Grid.Row="1" Background="#38414D" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button svc:UiVisibility.Key="InvoicePrint.ChangeTemplate_Click" Content="{DynamicResource S071}" Style="{StaticResource ActionButton}" Background="{StaticResource BrushRose}" Click="ChangeTemplate_Click" Margin="8"/>
                <Button svc:UiVisibility.Key="InvoicePrint.Print_Click" Content="{DynamicResource S072}" Style="{StaticResource ActionButton}" Click="Print_Click" Margin="8"/>
                <Button svc:UiVisibility.Key="InvoicePrint.Share_Click" Content="{DynamicResource S073}" Style="{StaticResource ActionButton}" Background="#34A853" Click="Share_Click" Margin="8"/>
                <Button svc:UiVisibility.Key="InvoicePrint.Close_Click" Content="{DynamicResource S012}" Style="{StaticResource SecondaryButton}" Click="Close_Click" Margin="8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
